MONGODB_URI=
MONGODB_DB_NAME=rushless
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Use a cryptographically secure random value. Length alone does not prove randomness.
# Server-only: never rename this to a NEXT_PUBLIC_* variable.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Temporary seed inputs. Keep out of source control and remove after bootstrap.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD_CONFIRM=
SUPER_ADMIN_BOOTSTRAP_CONFIRM=
# Set to exactly "true" only when deliberately adding another Super Admin.
SUPER_ADMIN_ALLOW_MULTIPLE=
